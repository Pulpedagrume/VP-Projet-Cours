        "head": "",
        "format": "<template>\n  <div class=\"journal\">\n    <div v-if=\"!msg || !msg.payload || msg.payload.length === 0\">Aucun événement.</div>\n    <div v-else v-for=\"(ligne, i) in msg.payload\" :key=\"i\" :class=\"ligne.includes('DÉCLENCHEMENT') ? 'decl' : ''\">{{ ligne }}</div>\n  </div>\n</template>\n\n<style scoped>\n.journal { max-height: 260px; overflow-y: auto; font-family: monospace; font-size: 13px; }\n.decl { color: #c62828; font-weight: bold; }\n</style>\n",
        "storeOutMessages": true,
