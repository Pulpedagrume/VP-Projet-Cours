    {
        "id": "fn_commandes",
        "type": "function",
        "z": "onglet_ihm",
        "name": "Commande -> Modbus",
        "func": "// Transforme une commande de l'IHM en écriture Modbus.\n// msg.payload = { commande: 'ouvrir' | 'fermer' | 'acquitter' | 'defaut', dj: 0..3, valeur }\n// dj : 0, 1, 2 = départs 1 à 3 ; 3 = arrivée\nconst a = global.get('adr');\nconst c = msg.payload;\nlet fc, adresse, valeur;\n\nif (c.commande === 'ouvrir') {\n    fc = 5; adresse = a.CO_ACR_OUVERTURE + c.dj; valeur = true;\n} else if (c.commande === 'fermer') {\n    fc = 5; adresse = a.CO_ACR_FERMETURE + c.dj; valeur = true;\n} else if (c.commande === 'acquitter') {\n    fc = 5; adresse = a.CO_ACR_ACQUITTEMENT; valeur = true;\n} else if (c.commande === 'defaut') {\n    fc = 6; adresse = a.HR_DEFAUT_INJECTE + c.dj; valeur = c.valeur;\n} else {\n    return null;\n}\n\n// fc 5 = écrire 1 coil, fc 6 = écrire 1 holding register\nmsg.payload = { value: valeur, fc: fc, unitid: 1, address: adresse, quantity: 1 };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 200,
        "wires": [
