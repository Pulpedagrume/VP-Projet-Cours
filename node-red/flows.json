        "func": "// Garde les derniers coils lus ; le décodage les utilisera.\nflow.set('coils', msg.payload);\nreturn null;\n",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 140,
        "wires": []
    },
    {
        "id": "lire_registres",
        "type": "modbus-read",
        "z": "onglet_ihm",
        "name": "Lire registres 0..102",
        "topic": "",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "unitid": "1",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "103",
        "rate": "500",
        "rateUnit": "ms",
        "delayOnStart": false,
        "startDelayTime": "",
        "server": "modbus_automate",
        "useIOFile": false,
        "ioFile": "",
