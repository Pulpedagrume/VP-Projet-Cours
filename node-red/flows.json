    {
        "id": "fn_adresses",
        "type": "function",
        "z": "onglet_ihm",
        "name": "Table des adresses",
        "func": "// Copie de src/demirame/mapping.py : les mêmes adresses côté IHM.\n// Si vous changez mapping.py, changez aussi ce tableau.\nglobal.set('adr', {\n    // Coils\n    CO_POSITION_DJ: 0,\n    CO_ACR_OUVERTURE: 30,\n    CO_ACR_FERMETURE: 40,\n    CO_ACR_ACQUITTEMENT: 50,\n    CO_SEUIL_PHASE: 60,\n    CO_SEUIL_HOMOPOLAIRE: 70,\n    CO_DECLENCHEMENT_PHASE: 80,\n    CO_DECLENCHEMENT_HOMOPOLAIRE: 90,\n    CO_VOYANT_ALARME: 100,\n    // Holding registers\n    HR_COURANT_DEPART: 0,\n    HR_COURANT_ARRIVEE: 3,\n    HR_COURANT_RESIDUEL: 4,\n    HR_TENSION_BARRE: 7,\n    HR_COMPTEUR_VIE: 20,\n    HR_DEFAUT_INJECTE: 100,\n    ECHELLE_TENSION: 10,\n});\nreturn null;\n",
        "outputs": 0,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 60,
        "wires": []
    },
